# Dockerfile.agent
FROM python:3.11-slim

# Install system dependencies and scanning tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    gnupg \
    lsb-release \
    dpkg \
    rpm \
    apt-transport-https \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for calling docker commands on host socket)
RUN curl -fsSL https://get.docker.com -o get-docker.sh && sh get-docker.sh && rm get-docker.sh

# Install Trivy (system package via APT repository)
RUN wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor -o /usr/share/keyrings/trivy.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" \
    | tee /etc/apt/sources.list.d/trivy.list \
    && apt-get update && apt-get install -y trivy \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy configuration
COPY pyproject.toml poetry.lock* README.md ./

# Check if lock file exists, if not generate it
RUN if [ ! -f poetry.lock ]; then poetry lock; fi

# Install dependencies only
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root

# Install Prowler (via pip, after poetry deps so pip is available)
RUN pip install --no-cache-dir prowler

# Copy source code
COPY src/ ./src/
# Install the project itself
RUN poetry install --no-interaction --no-ansi

# Configuration and output volumes
VOLUME ["/app/config", "/app/output"]

ENV PYTHONPATH=/app/src
ENV SBOM_CONFIG=/app/config/sbom.conf

CMD ["sbom-agent"]
